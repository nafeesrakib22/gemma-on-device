# Gemini API key (for the judge model if using benchmarks)
GEMINI_API_KEY=your_gemini_api_key_here

# Path to the LiteRT-LM model file
MODEL_PATH=/path/to/your/model.litertlm

# Active system prompt (survey | loan_reminder)
PROMPT_TYPE=survey

# Benchmark configuration (Optional)
AUDIO_DIR_PATH=/path/to/audio/wavs
TSV_FILE_PATH=./line_index.tsv
NUM_FILES_TO_TEST=5
REPORT_PATH=benchmark_report.csv
