# Environment configuration - copy to .env and fill in your values

# Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Path to the LiteRT-LM model file
MODEL_PATH=/path/to/your/model.litertlm

# Directory containing the audio files
AUDIO_DIR_PATH=/path/to/your/audio_files

# Path to the .tsv file with columns: file_name, sentence
TSV_FILE_PATH=./line_index.tsv

# How many files to test (default: 5)
NUM_FILES_TO_TEST=5

# Output report file path (CSV)
REPORT_PATH=benchmark_report.csv

# Active system prompt (survey | loan_reminder)
PROMPT_TYPE=survey

# Engine selection (gemma | gemini)
ENGINE=gemma
