# Benchmark configuration — copy to .env and fill in your values

# Gemini API key (for the judge model)
GEMINI_API_KEY=your_gemini_api_key_here

# Path to the LiteRT-LM model file
MODEL_PATH=/home/moriarty4k/.litert-lm/models/gemma-e2b/model.litertlm

# Directory containing the audio files
AUDIO_DIR_PATH=./audio_folder

# Path to the .tsv file with columns: file_name, sentence
TSV_FILE_PATH=./data/line_index.tsv

# How many files to test (default: 5)
NUM_FILES_TO_TEST=10

# Output report file path (CSV)
REPORT_PATH=benchmark_report.csv
